{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Itinerary",
  "type": "object",
  "properties": {
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "selections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Selection"
      }
    },
    "snapshot_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "profile",
    "selections"
  ],
  "$defs": {
    "AttendanceMode": {
      "type": "string",
      "enum": [
        "in_person",
        "remote"
      ]
    },
    "Profile": {
      "type": "object",
      "properties": {
        "attendance_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttendanceMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slot"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "registered_workshops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "goals",
        "topics",
        "available_windows",
        "registered_workshops"
      ]
    },
    "Selection": {
      "type": "object",
      "properties": {
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "rationale",
        "alternatives"
      ]
    },
    "Slot": {
      "type": "object",
      "properties": {
        "end": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "start"
      ]
    }
  }
}
